        <mxCell id="rules" value="&lt;b&gt;QUY TẮC CHUNG&lt;/b&gt;&lt;br&gt;Cancel tại bất kỳ state đã kết nối → Connected.&lt;br&gt;Ngắt hoặc mất kết nối TCP App Bridge → Disconnected.&lt;br&gt;Lệnh bị từ chối / gửi Joint-Pose thất bại → giữ state.&lt;br&gt;ACK bật Power/Servo/Stream chưa đủ để chuyển Ready.&lt;br&gt;Preparing chỉ tiến bước khi status xác nhận thành phần.&lt;br&gt;Status nền không tự đổi Driving hoặc JointBusy." style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=18;fontColor=#1e293b;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="740" width="750" height="270" />
        </mxCell>
        <mxCell id="footnote" value="JointBusy → Ready giải phóng trạng thái chờ của ứng dụng; timeout không xác nhận robot đã hoàn tất chuyển động.&lt;br&gt;Các mũi tên nét đứt biểu diễn chuyển trạng thái do dữ liệu status." style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Segoe UI;fontSize=16;fontColor=#1e293b;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=2;spacing=12;" vertex="1" parent="1">
