  <diagram id="rby1-detailed-architecture" name="Kiến trúc chi tiết">
    <mxGraphModel dx="2600" dy="2200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2700" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="KIẾN TRÚC CHI TIẾT — RBY1 DESKTOP QT ĐẾN ROBOT MÔ PHỎNG" style="text;html=1;align=center;verticalAlign=middle;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="20" width="1400" height="40" as="geometry"/></mxCell>
        <mxCell id="intro" value="Đọc từ trên xuống: người dùng ra lệnh → ứng dụng chuyển lệnh → ROS 2 điều phối → SDK/gRPC → robot mô phỏng. Mỗi mũi tên có ghi giao thức hoặc API." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="420" y="65" width="1850" height="28" as="geometry"/></mxCell>

        <mxCell id="l1" value="LAYER 1 — USER SPACE (máy tính của người vận hành)" style="swimlane;html=1;horizontal=1;startSize=32;rounded=1;fillColor=#EAF3FF;strokeColor=#4A86C5;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="2600" height="310" as="geometry"/></mxCell>
        <mxCell id="user" value="1. Người dùng&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Nhấn nút / giữ phím&lt;/font&gt;" style="ellipse;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="245" width="120" height="72" as="geometry"/></mxCell>
        <mxCell id="qtapp" value="Qt / C++ Desktop Application (mã nguồn của dự án này)" style="swimlane;html=1;horizontal=1;startSize=28;rounded=1;fillColor=#FFFFFF;strokeColor=#4A86C5;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="230" y="170" width="1120" height="220" as="geometry"/></mxCell>
        <mxCell id="gui" value="2. GUI Layer&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Buttons / Joint controls&lt;br&gt;Status, state và log&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4A86C5;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="255" y="245" width="205" height="95" as="geometry"/></mxCell>
        <mxCell id="ctrl" value="3. Application Controller&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;RobotController&lt;br&gt;Nhận và điều phối lệnh&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="515" y="245" width="210" height="95" as="geometry"/></mxCell>
        <mxCell id="state" value="4. State Pattern&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Disconnected · Connected · Preparing&lt;br&gt;Ready · Driving · JointBusy&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#B85450;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="235" width="255" height="112" as="geometry"/></mxCell>
        <mxCell id="client" value="5. RobotClient&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;QTcpSocket · JSON encode/decode&lt;br&gt;Hàng đợi request/response&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="245" width="230" height="95" as="geometry"/></mxCell>
        <mxCell id="moveit" value="TÙY CHỌN: MoveIt 2 / MoveGroup&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Lập kế hoạch quỹ đạo (không thuộc&lt;br&gt;luồng Qt hiện tại)&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#999999;dashed=1;fontSize=14;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1510" y="245" width="250" height="95" as="geometry"/></mxCell>

