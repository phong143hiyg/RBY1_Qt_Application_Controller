<mxfile host="app.diagrams.net" modified="2026-08-17T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="system-architecture" name="Kiến trúc hệ thống">
    <mxGraphModel dx="1900" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="KIẾN TRÚC HỆ THỐNG RBY1 DESKTOP QT" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="560" y="20" width="820" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Luồng đi từ thao tác người dùng đến robot mô phỏng. Nhãn trên mũi tên nêu rõ giao thức hoặc API được dùng." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="410" y="62" width="1120" height="28" as="geometry"/></mxCell>

        <mxCell id="desktop" value="ỨNG DỤNG DESKTOP (một tiến trình Qt/C++)" style="swimlane;html=1;horizontal=1;startSize=32;rounded=1;fillColor=#EAF3FF;strokeColor=#4A86C5;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="160" y="130" width="570" height="460" as="geometry"/></mxCell>
        <mxCell id="human" value="Người vận hành&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Nhấn nút, giữ phím điều khiển&lt;/font&gt;" style="ellipse;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="305" width="120" height="80" as="geometry"/></mxCell>
        <mxCell id="view" value="MainWindow&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Giao diện: kết nối, Prepare,&lt;br&gt;đế, 22 khớp và pose&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#4A86C5;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="185" y="245" width="165" height="110" as="geometry"/></mxCell>
        <mxCell id="controller" value="RobotController&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Điều phối lệnh, timer&lt;br&gt;velocity 100 ms; status 500 ms&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="225" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="states" value="RobotState (State Pattern)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Disconnected · Connected · Preparing&lt;br&gt;Ready · Driving · JointBusy&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#B85450;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="585" y="180" width="125" height="130" as="geometry"/></mxCell>
        <mxCell id="client" value="RobotClient&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;QTcpSocket; đóng gói / tách JSON&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="410" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="key" value="Vai trò State Pattern:&lt;br&gt;mỗi state chỉ cho phép các thao tác hợp lệ; giao diện không tự quyết định logic robot." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="515" width="505" height="55" as="geometry"/></mxCell>

        <mxCell id="bridge" value="C++ ROS 2 Bridge&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Chuyển lệnh JSON thành lời gọi ROS 2&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FCE4D6;strokeColor=#D79B00;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="330" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="ros" value="ROS 2 graph&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Topic / service / action&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1080" y="330" width="175" height="100" as="geometry"/></mxCell>
        <mxCell id="driver" value="RBY1 ROS 2 Driver&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Node điều khiển robot&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1345" y="330" width="185" height="100" as="geometry"/></mxCell>
        <mxCell id="sdk" value="RBY1 SDK&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;C++ API của robot&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1620" y="330" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="sim" value="RBY1 Simulator&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Robot mô phỏng&lt;/font&gt;" style="shape=cylinder;html=1;whiteSpace=wrap;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1850" y="330" width="150" height="100" as="geometry"/></mxCell>

        <mxCell id="e-human-view" value="Sự kiện UI&lt;br&gt;(click / press / release)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="human" target="view"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-view-controller" value="Qt Signal/Slot + lời gọi C++&lt;br&gt;connect, prepare, drive, joint, pose" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="view" target="controller"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-controller-view" value="Qt signals: stateChanged,&lt;br&gt;logMessage, jointStatusReceived" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;fontSize=12;fontColor=#666666;" edge="1" parent="1" source="controller" target="view"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="380"/><mxPoint x="265" y="380"/></Array></mxGeometry></mxCell>
        <mxCell id="e-controller-state" value="C++ State API (đa hình)&lt;br&gt;prepare / startDrive / nudgeJoint / onResponse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="controller" target="states"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-controller-client" value="C++ method calls + Qt signals" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="controller" target="client"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-client-bridge" value="TCP 127.0.0.1:8081&lt;br&gt;NDJSON request: {&quot;command&quot;: &quot;prepare|velocity|...&quot;} + \n" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="client" target="bridge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-bridge-client" value="TCP / NDJSON response&lt;br&gt;JSON: {&quot;success&quot;: true, &quot;ready&quot;: ...}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="bridge" target="client"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="520"/><mxPoint x="480" y="520"/></Array></mxGeometry></mxCell>
        <mxCell id="e-bridge-ros" value="ROS 2 API&lt;br&gt;/cmd_vel topic; joint/pose action;&lt;br&gt;prepare, power, servo, stream, status, cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="bridge" target="ros"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ros-driver" value="ROS 2 middleware&lt;br&gt;publish / call / execute" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="ros" target="driver"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-driver-sdk" value="RBY1 SDK C++ API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="driver" target="sdk"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-sdk-sim" value="gRPC&lt;br&gt;command / feedback" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=12;" edge="1" parent="1" source="sdk" target="sim"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="Chú giải: đường liền = gửi yêu cầu/lệnh; đường nét đứt = phản hồi, cập nhật giao diện." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="510" width="450" height="38" as="geometry"/></mxCell>
